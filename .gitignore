# Project Root Gitignore

# IDEs
.idea/
.vscode/
*.iml
*.iws

# Python / Flask (Web)
web/__pycache__/
web/.venv/
web/instance/
web/.env
web/*.db
web/*.sqlite3
web/.pytest_cache/
web/htmlcov/

# Flutter / Dart (Mobile)
mobile/app_mobile/.dart_tool/
mobile/app_mobile/.packages
mobile/app_mobile/.pub-cache/
mobile/app_mobile/.pub/
mobile/app_mobile/build/
mobile/app_mobile/android/local.properties
mobile/app_mobile/ios/Pods/
mobile/app_mobile/ios/.generated/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
